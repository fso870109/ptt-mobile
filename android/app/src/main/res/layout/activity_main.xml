<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <View
            android:id="@+id/connDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_ptt_listen" />

        <TextView
            android:id="@+id/connText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="未連線"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/meName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="@color/text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/settingsBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="設定"
            android:textColor="@color/sky"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/logout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="登出"
            android:textColor="@color/sky"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/alertBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sos"
        android:padding="10dp"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:orientation="horizontal">

        <TextView android:id="@+id/tabChannels" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_tab" android:gravity="center" android:text="頻道" android:textColor="@color/text" android:textSize="13sp" />
        <TextView android:id="@+id/tabMembers" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_tab" android:gravity="center" android:text="成員" android:textColor="@color/text" android:textSize="13sp" />
        <TextView android:id="@+id/tabDms" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_tab" android:gravity="center" android:text="私訊" android:textColor="@color/text" android:textSize="12sp" />
        <TextView android:id="@+id/tabChat" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_tab" android:gravity="center" android:text="訊息" android:textColor="@color/text" android:textSize="12sp" />
        <TextView android:id="@+id/tabLoc" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_tab" android:gravity="center" android:text="位置" android:textColor="@color/text" android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp">

        <ScrollView android:id="@+id/panelChannels" android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:id="@+id/channelList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </ScrollView>
        <ScrollView android:id="@+id/panelMembers" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="目前頻道的線上成員，點一下即可私人對講" android:textColor="@color/muted" android:textSize="12sp" android:layout_marginBottom="8dp" />
                <LinearLayout android:id="@+id/memberList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="其他線上的人" android:textColor="@color/muted" android:textSize="12sp" android:layout_marginTop="12dp" android:layout_marginBottom="8dp" />
                <LinearLayout android:id="@+id/otherList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
        <ScrollView android:id="@+id/panelDms" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
            <LinearLayout android:id="@+id/dmList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </ScrollView>
        <LinearLayout android:id="@+id/panelChat" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
            <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <LinearLayout android:id="@+id/messageList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            </ScrollView>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <EditText
                    android:id="@+id/chatInput"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:hint="輸入文字訊息"
                    android:inputType="textCapSentences|textMultiLine"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/text"
                    android:textColorHint="@color/muted"
                    android:textSize="14sp" />
                <TextView android:id="@+id/sendChat" android:layout_width="wrap_content" android:layout_height="44dp" android:gravity="center" android:paddingStart="10dp" android:paddingEnd="8dp" android:text="送出" android:textColor="@color/sky" android:textSize="15sp" />
                <TextView android:id="@+id/sendPhoto" android:layout_width="wrap_content" android:layout_height="44dp" android:gravity="center" android:paddingStart="4dp" android:paddingEnd="4dp" android:text="照片" android:textColor="@color/sky" android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
        <ScrollView android:id="@+id/panelLoc" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/shareLoc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="分享我的位置與電量"
                        android:textColor="@color/text" />
                </LinearLayout>
                <TextView android:id="@+id/locStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="8dp" android:text="未分享" android:textColor="@color/muted" android:textSize="12sp" />
                <LinearLayout android:id="@+id/locList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/targetLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="尚未加入頻道"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/roleBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/backToChannel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="← 回到頻道"
            android:textColor="@color/sky"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/talkStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="22dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/amber"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/captionBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp"
        android:textColor="@color/sky"
        android:textSize="14sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center">

        <TextView
            android:id="@+id/pttBtn"
            android:layout_width="168dp"
            android:layout_height="168dp"
            android:layout_gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_ptt"
            android:gravity="center"
            android:text="按住講話"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </FrameLayout>

    <TextView
        android:id="@+id/lastTalk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="這裡還沒有人說話"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/dispatchBtn"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input"
        android:gravity="center"
        android:text="呼叫調度台"
        android:textColor="@color/sky"
        android:textSize="15sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/sosBtn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_sos"
        android:gravity="center"
        android:text="🚨 長按 2 秒發出緊急警報"
        android:textColor="@android:color/white"
        android:textSize="15sp" />
</LinearLayout>
